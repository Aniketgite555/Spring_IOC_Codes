<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE beans PUBLIC "-//SPRING//DTD BEAN 2.0//EN"
			"https://www.springframework.org/dtd/spring-beans-2.0.dtd">
<beans>
	<bean id="d" class="com.DemoBooks">
		<property name="BooksId" value="1"></property>
		<property name="book">
			<list>
				<ref bean="b" />
				<ref bean="c"/>
			</list>
		</property>
	</bean>

	<bean id="b" class="com.Book">
		<property name="id" value="1"></property>
		<property name="bookname" value="King of india"></property>
	</bean>
	
	<bean id="c" class="com.Book">
		<property name="id" value="2"></property>
		<property name="bookname" value="Knight Riders"></property>
	</bean>

</beans>